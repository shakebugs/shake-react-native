source 'git@github.com:shakebugs/Specs.git'
source 'https://github.com/CocoaPods/Specs.git'

ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Build React-Core from source instead of using RN 0.86's prebuilt binary.
# The prebuilt React-Core, combined with use_frameworks! :linkage => :static and
# Xcode's explicitly-built Clang modules, breaks @react-native-firebase's iOS
# compilation ("RCTPromiseRejectBlock must be imported from module ... before it
# is required"). Building from source restores the header behavior RNFB expects.
# Note: the fmt/folly prebuilt (ReactNativeDependencies) is unaffected, so the
# original fmt consteval error stays fixed.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

project 'example',
        'DevelopmentDebug' => :debug,
        'DevelopmentRelease' => :release,
        'StagingDebug' => :debug,
        'StagingRelease' => :release,
        'ProductionDebug' => :debug,
        'ProductionRelease' => :release

target 'example' do

  pod 'RNFS', :path => '../node_modules/react-native-fs'
  pod 'RNCPushNotificationIOS', :path => '../node_modules/@react-native-community/push-notification-ios'

  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # @react-native-firebase headers include React headers (RCTConvert.h,
    # RCTBridgeModule.h, ...) non-modularly. Under `use_frameworks! :linkage => :static`
    # on RN 0.86 (prebuilt React-Core) clang treats these as a hard error
    # (-Werror=non-modular-include-in-framework-module). Allow non-modular includes
    # inside framework modules so the Firebase pods compile.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
